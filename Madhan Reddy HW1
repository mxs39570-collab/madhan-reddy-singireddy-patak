        "import re\n",
        "from collections import defaultdict\n",
        "\n",
        "def get_vocab(data):\n",
        "    vocab = defaultdict(int)\n",
        "    for word in data.split():\n",
        "        w = ' '.join(list(word)) + ' _'\n",
        "        vocab[w] += 1\n",
        "    return vocab\n",
        "\n",
        "def get_stats(vocab):\n",
        "    pairs = defaultdict(int)\n",
        "    for word, freq in vocab.items():\n",
        "        symbols = word.split()\n",
        "        for i in range(len(symbols) - 1):\n",
        "            pairs[symbols[i], symbols[i+1]] += freq\n",
        "    return pairs\n",
        "\n",
        "def merge_vocab(pair, v_in):\n",
        "    v_out = {}\n",
        "    bigram = re.escape(' '.join(pair))\n",
        "    p = re.compile(r'(?<!\\S)' + bigram + r'(?!\\S)')\n",
        "    for word in v_in:\n",
        "        w_out = p.sub(''.join(pair), word)\n",
        "        v_out[w_out] = v_in[word]\n",
        "    return v_out\n",
        "\n",
        "def print_corpus_snippet(vocab, num_lines=2):\n",
        "    count = 0\n",
        "    for word, freq in vocab.items():\n",
        "        if count < num_lines:\n",
        "            print(f\"  {word} ({freq})\")\n",
        "            count += 1\n",
        "        else:\n",
        "            break\n",
        "\n",
        "corpus_text = \"low low low low low lowest lowest newer newer newer newer newer newer wider wider wider new new\"\n",
        "vocab = get_vocab(corpus_text)\n",
        "\n",
        "print(\"--- Q2.1 MANUAL BPE SIMULATION ---\\n\")\n",
        "\n",
        "# Initial Vocabulary\n",
        "chars = set()\n",
        "for word in vocab:\n",
        "    chars.update(word.split())\n",
        "print(f\"Initial Vocabulary: {sorted(list(chars))}\")\n",
        "print(\"Initial Corpus Snippet:\")\n",
        "print_corpus_snippet(vocab, 5)\n",
        "print(\"\\n\" + \"=\"*30 + \"\\n\")\n",
        "\n",
        "# Perform 3 Merges\n",
        "for i in range(3):\n",
        "    print(f\"--- STEP {i+1} ---\")\n",
        "\n",
        "    pairs = get_stats(vocab)\n",
        "    best = max(pairs, key=pairs.get)\n",
        "    print(f\"Most Frequent Pair: '{best[0]}' + '{best[1]}' (Count: {pairs[best]})\")\n",
        "\n",
        "    vocab = merge_vocab(best, vocab)\n",
        "\n",
        "    new_token = ''.join(best)\n",
        "    current_tokens = set()\n",
        "    for word in vocab:\n",
        "        current_tokens.update(word.split())\n",
        "\n",
        "    print(f\"New Token: {new_token}\")\n",
        "    print(f\"Updated Vocabulary: {sorted(list(current_tokens))}\")\n",
        "    print(\"Updated Corpus Snippet:\")\n",
        "    print_corpus_snippet(vocab)\n",
        "    print(\"\\n\")"
